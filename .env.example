# LogMind AI Configuration Example
# Copy this file to .env and set your secrets

# Gemini AI Key (Optional for core parsing/analytics, required for AI Incident Explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
LOGMIND_ENV=development
LOGMIND_DB_PATH=data/logmind.db
LOGMIND_MAX_FILE_SIZE_MB=50
LOGMIND_ANOMALY_SPIKE_THRESHOLD=3.0
LOGMIND_MIN_ANOMALY_EVENTS=5
LOGMIND_SECRET_REDACTION_ENABLED=true
LOGMIND_ALLOWED_LOG_DIRS=sample_logs,logs,f:\My projects\logmind-ai\sample_logs
